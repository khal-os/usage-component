# Caddyfile — observability module (+ agent/chat) on a single VM.
# This is the LIVE shape of the namastex deployment (87.99.156.174); for a
# new deployment, change the hostnames — every directive below was earned
# in production and should be carried over:
#
#   - CORS on the API at the PROXY layer: every response carries it,
#     including 4xx/5xx and caddy-generated errors (502) that app-level
#     CORS can never cover. Wildcard is acceptable while the API is
#     public/credential-less; with KHAL_DISCOVERY_URL on, prefer the module's
#     CORS_ALLOWED_ORIGINS (exact-origin echo, audit D-1) and drop it here.
#   - LangWatch CSP rewrite: upstream sends `frame-ancestors 'none'`,
#     which blocks embedding in the demo desktop. Substitute ONLY that
#     directive; scope to 'self' + the desktop origin, never '*'.
#   - LangWatch cookie rewrite: session cookies ship SameSite=Lax, which
#     browsers refuse to send in a cross-origin iframe — the embed loads
#     but never keeps the session. None (cookie is already Secure) makes
#     it travel; better-auth's Origin checks remain the CSRF guard.
#
# DEPLOY STATE RULE: /etc/caddy/Caddyfile on the VM is written from THIS
# file. No module/agent redeploy may touch /etc/caddy — and any manual
# hotfix on the VM must be copied back here, or it dies with the VM.

# Module API — the product surface (client integrations, docs at /api/v1/docs/)
#
# EDGE AUTH (interim, 2026-08-09): the khal Auth System is not deployed on
# real infra yet, so the module-level introspection gate (KHAL_* quartet)
# stays off and THIS basicauth is what closes the otherwise-public archive.
# The plaintext credential lives ONLY in clients/namastex.env on the VM
# (deploy state). Preflights stay open (browsers send no credentials on
# OPTIONS); callers (Farol, scripts) send `Authorization: Basic …` — already
# in the CORS allow-list. When the platform lands: set the KHAL_* quartet
# in the client env, recreate api, and DELETE this block + the wildcard
# CORS below (module CORS_ALLOWED_ORIGINS takes over, audit D-1).
# (caddy 2.6 spells it `basicauth`; 2.8+ renamed it `basic_auth`.)
api.87-99-156-174.sslip.io {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}
	# Matcher required: caddy's directive order runs basicauth BEFORE
	# handle, so without it the @preflight 204 above never fires (browsers
	# send no credentials on OPTIONS and CORS would break).
	@gated not method OPTIONS
	basicauth @gated {
		namastex $2a$14$pun30cOJOPP4Z19rPOtAau7j0yXRGcmyx2I7jPLGt..PckzNWVYye
	}
	header Access-Control-Allow-Origin "*"
	reverse_proxy 127.0.0.1:3003
}

# LangWatch — trace ingestion front door + operator UI. Hostname must equal
# LANGWATCH_PUBLIC_URL in the client env.
langwatch.87-99-156-174.sslip.io {
	reverse_proxy 127.0.0.1:5563 {
		header_down Content-Security-Policy "frame-ancestors 'none'" "frame-ancestors 'self' https://khal-demo-desktop.onrender.com"
		header_down Set-Cookie "SameSite=Lax" "SameSite=None"
	}
}

# WhatsApp chat UI (proxies the agent internally; agent stays unpublished)
chat.87-99-156-174.sslip.io {
	reverse_proxy 127.0.0.1:8899
}
