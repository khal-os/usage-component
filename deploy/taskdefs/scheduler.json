{
  "family": "${FAMILY}",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "${CPU}",
  "memory": "${MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "scheduler",
      "image": "${IMAGE}",
      "command": ["node", "dist/main/jobs/run-billing-close-scheduler.js"],
      "essential": true,
      "stopTimeout": 60,
      "environment": [
        { "name": "ENVIRONMENT", "value": "${ENV_WORD}" },
        { "name": "CLIENT_NAME", "value": "${CLIENT_NAME}" },
        { "name": "CLIENT_TIMEZONE", "value": "${CLIENT_TIMEZONE}" },
        { "name": "MONGO_DB_ATLAS", "value": "true" },
        { "name": "MONGO_USAGE_DB_NAME", "value": "${MONGO_USAGE_DB_NAME}" },
        { "name": "LOG_LEVEL", "value": "${LOG_LEVEL}" },
        { "name": "LOG_FORMAT", "value": "${LOG_FORMAT}" },
        { "name": "SERVER_PORT", "value": "3000" },
        { "name": "BILLING_AUTO_CLOSE_DELAY_MINUTES", "value": "${BILLING_AUTO_CLOSE_DELAY_MINUTES}" },
        { "name": "BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS", "value": "${BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS}" }
      ],
      "secrets": [
        { "name": "MONGO_DB_HOST", "valueFrom": "${MONGO_SECRET_ARN}:MONGO_DB_HOST::" },
        { "name": "MONGO_DB_USER", "valueFrom": "${MONGO_SECRET_ARN}:MONGO_DB_USER::" },
        { "name": "MONGO_DB_PASSWORD", "valueFrom": "${MONGO_SECRET_ARN}:MONGO_DB_PASSWORD::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
