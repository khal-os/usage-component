# hapvida · prod — see deploy/tenants/example.env for what every key means.
# Values below are the ones actually provisioned in account 504557607647 on
# 2026-08-15 (report: /aws-bootstrap hapvida prod).

CLIENT_NAME=hapvida
ENVIRONMENT=prod
AWS_ACCOUNT_ID=504557607647
AWS_REGION=sa-east-1
BASE_DOMAIN=hapvida.khal.ai

# Nothing has been pushed to this account's ECR yet. The first
# `make aws-deploy CLIENT=hapvida SHA=<sha>` sets this.
IMAGE_SHA=

# Flipped to true once the account's ECR push role is exercised end-to-end —
# until then the build-images leg for hapvida is parked, not red.
IMAGES_ENABLED=false

CLIENT_TIMEZONE=America/Sao_Paulo
MONGO_USAGE_DB_NAME=usage_db

MONGO_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:504557607647:secret:khal/hapvida/prod/usage/mongo-IUbxAH
LANGWATCH_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:504557607647:secret:khal/hapvida/prod/usage/langwatch-BVGY6O

# khal-auth is not yet stood up for hapvida — the API is OPEN until this is
# filled, which is a declared state, warned at boot, and asserted by
# preflight so it cannot be forgotten silently.
KHAL_AUTH_URL=
KHAL_TOKEN_AUDIENCE=tracing,billing
CORS_ALLOWED_ORIGINS=
LANGWATCH_EMBED_ORIGIN=

API_CPU=256
API_MEMORY=512
API_AUTOSCALE_MAX=4
CONNECTOR_CPU=256
CONNECTOR_MEMORY=512
SCHEDULER_CPU=256
SCHEDULER_MEMORY=512
BACKUP_CPU=256
BACKUP_MEMORY=512

# F1 in the bootstrap report: t3.xlarge, gp3 50 GB. The volume is 50 here,
# not example.env's 100 — that is what infra provisioned; the load-test gate
# is what decides whether it stays.
LANGWATCH_INSTANCE_TYPE=t3.xlarge
LANGWATCH_VOLUME_GB=50
LANGWATCH_WORKERS_REPLICAS=2
LANGWATCH_MEMORY_LIMIT=2g
LANGWATCH_REDIS_MEMORY_LIMIT=1g
LANGWATCH_CLICKHOUSE_MEMORY_LIMIT=3g
LANGWATCH_CLICKHOUSE_CPU_LIMIT=1.5
LANGWATCH_CLICKHOUSE_URL=http://clickhouse.internal.usage:8123

TRACE_INGESTION_INTERVAL_SECONDS=60
TRACE_INGESTION_BATCH_SIZE=1000
TRACE_INGESTION_QUIET_PERIOD_SECONDS=900
REPROCESS_INTERVAL_SECONDS=3600

BILLING_AUTO_CLOSE_DELAY_MINUTES=60
BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS=900

LOG_LEVEL=info
LOG_FORMAT=json
