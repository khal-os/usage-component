# One file per tenant — THIS is the tenant's declared identity and capacity
# (decision 139: no defaults for any of it; decision 149: the file is also
# what every AWS name is computed from). Copy to deploy/tenants/<client>.env
# and commit: no secret VALUE ever lives here, only names and ARNs.
#
# Same shape and reader as the compose world's clients/<name>.env — KEY=value,
# read by `tget` in deploy/scripts/naming.sh. Two directories, one convention:
# clients/ is the compose world, deploy/tenants/ is the AWS one.
#
# The filename must match CLIENT_NAME, and ENVIRONMENT must be prod or hml —
# naming.sh refuses anything else before a single AWS call is made.

# ── identity (every name and path is computed from these) ───────────────────
CLIENT_NAME=example
# prod | hml — nothing else exists on AWS (dev is local compose). This exact
# token appears in every resource name AND every store path; the container's
# own ENVIRONMENT var gets the full word (production/homolog) from env_word.
ENVIRONMENT=prod
AWS_ACCOUNT_ID=000000000000
AWS_REGION=sa-east-1
# The client's own zone, delegated from khal.ai. Never created by us —
# looked up and asserted. Hostnames default to api.<BASE_DOMAIN> and
# langwatch.<BASE_DOMAIN>.
BASE_DOMAIN=example.khal.ai
# [REQUIRED] Nome exato do bucket de backups, como infra o criou. A forma
# padrão é khal-<client>-<env>-usage-backups-<account>, mas o valor que vale é
# o que existe na conta: bucket S3 não se renomeia, então o nome é declarado,
# nunca calculado. Guarda backups/<client>/ e config/<client>/.
BACKUP_BUCKET=khal-example-prod-usage-backups-000000000000
# API_HOSTNAME=api.example.com
# LANGWATCH_HOSTNAME=langwatch.example.com

# Seed for the FIRST `--register-only`, when no task definition exists yet
# to be asked what is deployed. It is not a record: what is running is read
# from ECS by preflight, which is the authoritative answer. Safe to leave
# stale, safe to leave empty once the account has deployed once.
IMAGE_SHA=

# false parks this tenant out of the build-images fan-out — commit the file
# BEFORE the account is bootstrapped without turning that leg red forever.
IMAGES_ENABLED=false

# ── app identity ────────────────────────────────────────────────────────────
# Decision 130: the billing boundary IS the display zone.
CLIENT_TIMEZONE=America/Sao_Paulo
MONGO_USAGE_DB_NAME=usage_db

# ── secret ARNs (decision 150) ──────────────────────────────────────────────
# NOT secrets — addresses. Secrets Manager appends a random 6-char suffix to
# every ARN, so it cannot be computed from the name, and injecting a single
# JSON KEY of a secret requires the full ARN form. Declared here, verified
# against the live secret by `preflight-aws.sh` (operator/audit creds), so
# the CD role never needs secretsmanager permissions at all.
MONGO_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:000000000000:secret:khal/example/prod/usage/mongo-XXXXXX
LANGWATCH_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:000000000000:secret:khal/example/prod/usage/langwatch-XXXXXX

# ── module API ──────────────────────────────────────────────────────────────
# Empty = auth OFF (the API answers OPEN — a declared posture for non-khal
# tenants, warned loudly at boot), never a half-enabled gate. Khal tenant whose
# khal-auth comes up AFTER usage: come back and fill it (https://auth.<domain>)
# — hapvida stayed open for a day because nobody did (17/08/2026).
KHAL_AUTH_URL=
# Accepted `aud` claims, comma-separated, ANY matches. Both apps that read
# this module's data (capability billing.ledger) are admitted by default.
KHAL_TOKEN_AUDIENCE=tracing,billing
# Comma-separated list; each entry an exact https origin OR an
# https://*.<domain> wildcard-subdomain pattern. Left empty the renderer
# fills in https://*.${BASE_DOMAIN}; set it and YOUR list is used verbatim.
CORS_ALLOWED_ORIGINS=
# Origins allowed to FRAME LangWatch (frame-ancestors). Empty = derived:
# "https://<BASE_DOMAIN> https://*.<BASE_DOMAIN>" — the apex explicitly, because
# the Khal desktop lives there and a wildcard does not match it. Never "*".
LANGWATCH_EMBED_ORIGIN=

# ── Fargate sizing, per family ──────────────────────────────────────────────
# Declared, not baked into the task-def templates: resizing a tenant is a
# tenant-file edit, and a value nobody chose is exactly the silent default
# this file exists to abolish.
API_CPU=256
API_MEMORY=512
API_AUTOSCALE_MAX=4
CONNECTOR_CPU=256
CONNECTOR_MEMORY=512
SCHEDULER_CPU=256
SCHEDULER_MEMORY=512
BACKUP_CPU=256
BACKUP_MEMORY=512

# ── LangWatch host ──────────────────────────────────────────────────────────
# Sizing is INFORMATION FOR INFRA (they own the instance) — the deploy
# pipeline never touches EC2. Shipped at the load-test tier, not the cost
# floor: decision 140's 1000 traces/s gate is a per-account onboarding step,
# and its own procedure calls for 2 workers and 3g ClickHouse, which do not
# fit the 8 GB t3a.large. A new client starts at the line the gate requires.
LANGWATCH_INSTANCE_TYPE=t3.xlarge
LANGWATCH_VOLUME_GB=100
# The capacity knobs below ARE shipped by deploy — as a JSON blob into
# /khal/<client>/<env>/usage/langwatch-capacity, which the box re-reads on
# every service start.
LANGWATCH_WORKERS_REPLICAS=2
LANGWATCH_MEMORY_LIMIT=2g
LANGWATCH_REDIS_MEMORY_LIMIT=1g
LANGWATCH_CLICKHOUSE_MEMORY_LIMIT=3g
LANGWATCH_CLICKHOUSE_CPU_LIMIT=1.5
# Stable private DNS of the LangWatch box inside this tenant's VPC — survives
# instance replacement with no task-def churn. The zone is per tenant
# (<client>.internal.usage, decision 164): a private zone is scoped by VPC
# association, not by name, so a shared `internal.usage` would leave N
# identically-named zones in one account, told apart only by association —
# and associating the wrong one points a client's connector at another
# client's ClickHouse.
LANGWATCH_CLICKHOUSE_URL=http://clickhouse.example.internal.usage:8123

# ── sync worker ─────────────────────────────────────────────────────────────
TRACE_INGESTION_INTERVAL_SECONDS=60
TRACE_INGESTION_BATCH_SIZE=1000
TRACE_INGESTION_QUIET_PERIOD_SECONDS=900
REPROCESS_INTERVAL_SECONDS=3600

# ── billing auto-close (decision 131 — ON in the factory) ───────────────────
BILLING_AUTO_CLOSE_DELAY_MINUTES=60
BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS=900

# ── logging (decision 134) ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
