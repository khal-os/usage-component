{
  "name": "observability-component",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build -w @observability/core && npm run build -w @observability/module -w @observability/connector",
    "bump": "./scripts/bump-version.sh",
    "register-module": "./scripts/register-module.sh",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run build && node scripts/packaging-check.mjs && npm run test:ci --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit:ci": "npm run test:unit:ci --workspaces --if-present",
    "test:ci:random": "npm run build && node scripts/packaging-check.mjs && npm run test:ci --workspaces --if-present -- --randomize",
    "prepare": "node .husky/install.mjs || true"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,mjs,cjs,json}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
