{
  "name": "@observability/connector",
  "version": "1.0.0",
  "description": "The trace-source side: LangWatch adapters (ClickHouse/HTTP/fake), the sync write path and the ingestion worker. Depends on @observability/core only.",
  "type": "module",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./domain/*": "./dist/domain/*",
    "./application/*": "./dist/application/*",
    "./infrastructure/*": "./dist/infrastructure/*",
    "./main/*": "./dist/main/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json",
    "sync": "ENVIRONMENT=development tsx src/main/jobs/run-sync.ts",
    "ingestion:loop": "ENVIRONMENT=development tsx src/main/jobs/run-trace-ingestion-loop.ts",
    "test": "ENVIRONMENT=test jest --passWithNoTests --silent --noStackTrace --collectCoverage=false --runInBand",
    "test:verbose": "ENVIRONMENT=test jest --passWithNoTests",
    "test:unit": "npm test -- --watch --config=jest-unit.config.mjs",
    "test:integration": "npm test -- --watch --config=jest-integration.config.mjs",
    "test:ci": "ENVIRONMENT=test jest --passWithNoTests --silent --runInBand --collectCoverage=true --json --outputFile=jest-results.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit:ci": "ENVIRONMENT=test jest --passWithNoTests --silent --noStackTrace --collectCoverage=false --config=jest-unit.config.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@observability/core": "*",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  }
}
