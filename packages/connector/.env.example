## Database (o mesmo store permanente que o module lê)
MONGO_DB_HOST="127.0.0.1"
MONGO_USAGE_DB_NAME="your_database_name"
MONGO_DB_PORT="27017"

## Fonte ClickHouse direta (decisões 59/127 — a ÚNICA fonte real; sem ela o
## worker fica ocioso e o sync RECUSA rodar — nada de fallback silencioso)
# LANGWATCH_CLICKHOUSE_URL="http://127.0.0.1:8123"
# LANGWATCH_CLICKHOUSE_USER="default"
# LANGWATCH_CLICKHOUSE_PASSWORD="langwatch"
# LANGWATCH_CLICKHOUSE_DATABASE="langwatch"
# LANGWATCH_PROJECT_ID=""

## Opt-in EXPLÍCITO de fixtures para demo offline (decisão 127) — nunca em
## cliente real: sem fonte configurada o sync quebra em vez de adivinhar
# TRACE_SOURCE="fixtures"

## Knobs do worker de ingestão (defaults entre parênteses)
# TRACE_INGESTION_INTERVAL_SECONDS="60"
# TRACE_INGESTION_BATCH_SIZE="1000"
# TRACE_INGESTION_QUIET_PERIOD_SECONDS="900"
# REPROCESS_INTERVAL_SECONDS="3600"

## Decision 130: business timezone of THIS deployment (IANA) — quarantine/reprocess cut at this midnight
CLIENT_TIMEZONE="America/Sao_Paulo"

## Logging (opcional): nível mínimo e formato das linhas no stdout.
## LOG_LEVEL: trace|debug|info|warn|error|fatal|silent (default: info)
## LOG_FORMAT: json|pretty (default: json em produção/test, pretty em development)
# LOG_LEVEL="info"
# LOG_FORMAT="json"
