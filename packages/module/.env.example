## Server
SERVER_PORT="3000"

## Session auth (optional — without KHAL_AUTH_URL the API is OPEN, PoC
## behavior, warned loudly at boot). Set, every /api/v1 request must carry a
## khal-auth session JWT verified locally against the JWKS at
## ${KHAL_AUTH_URL}/.well-known/jwks.json (RS256; iss == the URL, aud ==
## KHAL_TOKEN_AUDIENCE — default "tracing" —, `tenant` claim == KHAL_TENANT,
## exp checked). Identity-only, no scopes. KHAL_TENANT is REQUIRED when the
## URL is set (the boot refuses half a pair). The interim BASIC_AUTH_* gate
## (decision 141) is gone — no aliases.
# KHAL_AUTH_URL="http://127.0.0.1:7101"
# KHAL_TENANT=""
# KHAL_TOKEN_AUDIENCE="tracing"

## Database
MONGO_DB_HOST="127.0.0.1"
MONGO_USAGE_DB_NAME="your_database_name"
MONGO_DB_PORT="27017"

## Decision 130: business timezone of THIS deployment (IANA) — billing boundary = display zone
CLIENT_TIMEZONE="America/Sao_Paulo"

## Logging (opcional): nível mínimo e formato das linhas no stdout.
## LOG_LEVEL: trace|debug|info|warn|error|fatal|silent (default: info)
## LOG_FORMAT: json|pretty (default: json em produção/test, pretty em development)
# LOG_LEVEL="info"
# LOG_FORMAT="json"
