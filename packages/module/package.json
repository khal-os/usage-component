{
  "name": "@observability/module",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json",
    "start": "ENVIRONMENT=development node dist/main/index.js",
    "deploy": "npm run build && npm run start",
    "start:dev": "ENVIRONMENT=development tsx watch src/main/index.ts",
    "migrate": "ENVIRONMENT=development tsx src/main/jobs/run-migrations.ts",
    "price:insert": "ENVIRONMENT=development tsx src/main/jobs/insert-price-version.ts",
    "reprocess:pending": "ENVIRONMENT=development tsx src/main/jobs/reprocess-pending.ts",
    "billing:close": "ENVIRONMENT=development tsx src/main/jobs/close-billing-period.ts",
    "billing:reopen": "ENVIRONMENT=development tsx src/main/jobs/reopen-billing-period.ts",
    "billing:scheduler": "ENVIRONMENT=development tsx src/main/jobs/run-billing-close-scheduler.ts",
    "test": "ENVIRONMENT=test jest --passWithNoTests --silent --noStackTrace --collectCoverage=false --runInBand",
    "test:verbose": "ENVIRONMENT=test jest --passWithNoTests",
    "test:unit": "npm test -- --watch --config=jest-unit.config.mjs",
    "test:integration": "npm test -- --watch --config=jest-integration.config.mjs",
    "test:ci": "ENVIRONMENT=test jest --passWithNoTests --silent --runInBand --collectCoverage=true --json --outputFile=jest-results.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit:ci": "ENVIRONMENT=test jest --passWithNoTests --silent --noStackTrace --collectCoverage=false --config=jest-unit.config.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@observability/connector": "*",
    "@shelf/jest-mongodb": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@observability/core": "*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "mongodb": "^7.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": "./dist/*"
  }
}
