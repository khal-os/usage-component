.vscode
node_modules
.claude/settings.local.json

# Real client env files carry secrets — only the template is committed
clients/*.env
!clients/example.production.env
!clients/example.development.env
demo-data/

# Generated load-test archives (scripts/generate-loadtest-traces.mjs) — GBs.
# The loadtest TOOLING (generator, watcher, README) is tracked.
loadtest/*.archive.gz

# Mongo backups (make backup) — client data, never committed
backups/

# Terraform is gone (decision 155): CD ships images, task-definition
# revisions and config artifacts into stores infra pre-created, and
# preflight-aws.sh is the single checker. These patterns stay only so a
# stray local .terraform/ from an old checkout is never committed.
**/.terraform/
*.tfstate
*.tfstate.*

# jest --json output from test:ci — dashboard input, never committed
packages/*/jest-results.json

# PR-dashboard runtime dirs (CI workspace / local dry-runs)
.ci-metrics/
image-metrics/
.ci-jobs.json
.dashboard.md
.docker-dashboard.md
