.vscode
node_modules
.claude/settings.local.json

# Real client env files carry secrets — only the template is committed
clients/*.env
!clients/example.production.env
!clients/example.development.env
demo-data/

# Generated load-test archives (scripts/generate-loadtest-traces.mjs) — GBs.
# The loadtest TOOLING (generator, watcher, README) is tracked.
loadtest/*.archive.gz

# Mongo backups (make backup) — client data, never committed
backups/

# Terraform: state is remote (S3), local artifacts and real backend/tfvars
# configs name live infrastructure — never committed
**/.terraform/
*.tfstate
*.tfstate.*
deploy/terraform/**/backend.hcl
deploy/terraform/**/*.auto.tfvars
