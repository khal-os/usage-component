# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ PRODUCTION ENV CONTRACT — one single-tenant client deployment              ║
# ║ (compose.module.yml + compose.connector.yml + compose.mongodb.yml).       ║
# ║ This file is the FULL contract; the workstation/demo shape is             ║
# ║ example.development.env.                                                   ║
# ║                                                                            ║
# ║ This file is the ONLY thing that knows the client. To deploy N clients,   ║
# ║ create N copies (real ones are gitignored — they hold secrets and are     ║
# ║ the stack's operational identity) and apply the same compose chain:       ║
# ║                                                                            ║
# ║   docker compose -f compose.module.yml -f compose.connector.yml \         ║
# ║     -f compose.mongodb.yml --env-file clients/<name>.env up -d            ║
# ║                                                                            ║
# ║ Tags:  [REQUIRED]   the stack won't start (or bills wrong) without it     ║
# ║        [RECOMMENDED] production should set it — think before skipping     ║
# ║        [OPTIONAL]   the commented default applies                         ║
# ║        [SECRET→SM]  belongs in AWS Secrets Manager — JSON secrets under   ║
# ║                     khal/<client>/<env>/usage/* (ADR-103; today still     ║
# ║                     usage/<client> until the U2 path migration), hydrated ║
# ║                     at deploy as a second --env-file. Until wired, these  ║
# ║                     live ONLY here (chmod 600, gitignored, no other copy).║
# ║                                                                            ║
# ║ Blocks: 1·Identity  2·LangWatch  3·Database  4·Images  5·khal auth        ║
# ║         6·Exposure  7·Data-store tuning  8·Sync worker  9·Auto-close      ║
# ║         10·LangWatch scaling                                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─── 1 · IDENTITY — who this client is ───────────────────────────────────────

# [REQUIRED] Compose project (container/volume/network prefix) and the
# client's database name. Keep both equal to the client slug.
COMPOSE_PROJECT_NAME=
CLIENT_NAME=

# [REQUIRED] Decision 130: the client's business timezone, IANA name. One
# knob: the invoice's month boundary AND every displayed timestamp cut at
# THIS zone's midnight — the screen always agrees with the bill.
# Forward-only: never change it after a month has closed.
CLIENT_TIMEZONE=

# ─── 2 · LANGWATCH — the client's trace store front ──────────────────────────

# [REQUIRED] The BROWSER-visible URL of THIS client's LangWatch — in
# production, the reverse-proxy URL (e.g. https://langwatch.<host>, see
# deploy/RUNBOOK-VM.md; the proxy must be up before onboarding). LangWatch's
# own three URLs are set from this one value and session auth validates
# against it — a mismatch fails login. Compose refuses to start without it.
LANGWATCH_PUBLIC_URL=

# [REQUIRED] [SECRET→SM] Per-instance secrets — generate each:
# `openssl rand -base64 32`. Compose refuses to start (or stop) the connector
# role while any is empty. CREDENTIALS_SECRET must NEVER change after first
# boot (stored credentials become undecryptable) — in Secrets Manager, mark
# it non-rotatable.
LANGWATCH_NEXTAUTH_SECRET=
LANGWATCH_API_TOKEN_JWT_SECRET=
LANGWATCH_CREDENTIALS_SECRET=

# [REQUIRED — written by scripts/3-onboard-langwatch.sh] LangWatch project id
# (project_..., visible in the LangWatch UI URL). BOTH the row filter of the
# direct-ClickHouse sync AND the ingestion gate (decision 127): while empty,
# the trace-ingestion-worker idles and `make sync` refuses to run.
LANGWATCH_PROJECT_ID=

# ─── 3 · DATABASE — the permanent archive ────────────────────────────────────

# [REQUIRED in prod] [SECRET→SM: password] Mongo root credentials for this
# client's OWN mongo (created on first boot, enforced from then on; set
# BEFORE first boot — the volume keeps the first-boot user). Store the pair
# together in the client's SM JSON (the user is not secret but travels with
# its password).
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# [OPTIONAL] Mongo container memory limit (default 512m). Mongo sizes its
# cache from this — keep it ≥ the working set (decision 77: 1M traces
# ≈ 3.4 GB; 4g keeps every query path in memory).
# MONGO_MEMORY_LIMIT=512m

# [OPTIONAL] EXTERNAL database (decision 65): drop compose.mongodb.yml from
# the chain and set host/port (+ credentials above). MUST be a replica set
# (decision 81 — multi-document transactions); managed offerings always are.
# MONGO_DB_HOST=mongo
# MONGO_DB_PORT=27017
#
# [OPTIONAL] MongoDB ATLAS: the four lines below (PORT ignored — SRV picks;
# value must be exactly `true`; the Makefile then drops compose.mongodb.yml
# automatically). Atlas Network Access must allowlist this host's PUBLIC IP.
# `make backup` assumes the in-project mongo — with Atlas use Atlas tooling.
# MONGO_DB_ATLAS=true
# MONGO_DB_HOST=cluster0.xxxxx.mongodb.net
# MONGO_DB_USER=
# MONGO_DB_PASSWORD=
#
# [REQUIRED] The usage store's database name (decision 139: declared, never
# inferred — the old CLIENT_NAME fallback could misroute the archive in a
# cluster shared by several of this client's databases). Single-tenant
# convention: use the client slug.
MONGO_USAGE_DB_NAME=

# ─── 4 · IMAGES — which builds run ───────────────────────────────────────────

# [RECOMMENDED] Pin registry tags in production (e.g.
# <registry>/platform-module:1.4.2) — rollback = repoint the tag. Empty falls
# back to the locally-built :local images (build-on-box deploys).
MODULE_IMAGE=
CONNECTOR_IMAGE=

# ─── 5 · KHAL SESSION AUTH (ADR-103 naming) ──────────────────────────────────
# [RECOMMENDED] KHAL_AUTH_URL turns the session gate ON: every /api/v1
# request must carry a khal-auth session JWT, verified locally against the
# JWKS at ${KHAL_AUTH_URL}/.well-known/jwks.json (RS256; iss == the URL,
# aud == KHAL_TOKEN_AUDIENCE, `tenant` claim == KHAL_TENANT, exp checked;
# identity-only, no scopes). KHAL_TENANT is REQUIRED when the URL is set —
# the boot refuses half a pair. All empty = /api/v1 OPEN (PoC behavior) —
# never expose an open API beyond loopback. The URL resolves FROM INSIDE the
# api container (127.0.0.1 there is the container itself). Prove it took
# effect: ./scripts/5-verify-client.sh <name> asserts tokenless requests
# answer 401. (The interim BASIC_AUTH_* gate of decision 141 is GONE — no
# aliases.)
KHAL_AUTH_URL=
KHAL_TENANT=
# [OPTIONAL] Expected `aud` claim of the session token (default: tracing).
# KHAL_TOKEN_AUDIENCE=tracing

# ─── 6 · EXPOSURE — loopback by default ──────────────────────────────────────

# [OPTIONAL] Host ports. Dedicated host per client: OMIT all three — compose
# defaults apply (API 3000, LangWatch 5560, UI 8080) and the deploy scripts
# print/probe well-formed URLs. Shared host: unique ports per client.
# API_PORT=3000
# LANGWATCH_PORT=5560

# [OPTIONAL] Bind address per published port — default LOOPBACK (127.0.0.1):
# nothing reachable from other machines until you opt in. Exposing needs BOTH
# *_BIND=0.0.0.0 AND a firewall.
# API_BIND=127.0.0.1
# LANGWATCH_BIND=127.0.0.1

# [OPTIONAL] Print-only: public URL of the module API — deploy summaries
# (5-verify-client.sh) print it instead of the localhost form.
# MODULE_PUBLIC_URL=

# [OPTIONAL] Cross-origin API access (audit D-1) — opt-in and EXACT:
# comma-separated origins echoed back individually (never a wildcard; the
# archive is unmasked LLM content). Unset = no browser cross-origin
# access (the default posture: integrations call the API server-side).
# CORS_ALLOWED_ORIGINS=

# ─── 7 · SYNC WORKER — production keeps the defaults (shown) ─────────────────

# [OPTIONAL] Seconds between "anything new?" polls once caught up.
# TRACE_INGESTION_INTERVAL_SECONDS=60
# [OPTIONAL] Max traces per sync tick — the worker's memory/work bound.
# TRACE_INGESTION_BATCH_SIZE=1000
# [OPTIONAL] Seconds a trace must stay UNCHANGED before ingestion
# (decision 61): ingest mid-run = partial spans/tokens priced forever.
# TRACE_INGESTION_QUIET_PERIOD_SECONDS=900
# [OPTIONAL] Backstop cadence for re-stamping pending_price traces — price
# registration already reprocesses immediately (decision 57).
# REPROCESS_INTERVAL_SECONDS=3600

# ─── 8 · MONTH AUTO-CLOSE (decision 131) — explicit OPT-IN, off by default ───

# [OPTIONAL] Without this line the billing-close-scheduler service does not
# exist and closing stays runbook-only (make billing-close). Enabled, the
# scheduler closes each fully-past month at the client's midnight + the delay
# below, oldest first, through the SAME use case as the runbook. pending_price
# blocks and retries each cycle (QA5: the bill WAITS); a REOPENED month never
# auto-recloses. Disable later: comment + `make up` (then `up
# --remove-orphans` cleans the orphan container).
# COMPOSE_PROFILES=billing-auto-close
# BILLING_AUTO_CLOSE_DELAY_MINUTES=60
# BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS=900

# ─── 9 · LANGWATCH CAPACITY (decisions 78 + 139) ─────────────────────────────

# [REQUIRED] Capacity is a decision, not a default (decision 139): the
# 1000 traces/s incident ran dev-shaped fallbacks nobody chose (512m redis
# queue → OOM, 1 worker draining). Compose refuses to start without these
# five. The scaling unit is langwatch-workers (stateless queue consumers
# over the single postgres/redis/clickhouse spine); app and
# trace-ingestion-worker stay at 1 replica by design. Raising replicas
# multiplies load on the same three stores — raise their limits too and
# budget host RAM. Reference values: dev-sized 1/2g/512m/2g/1.0; the
# loadtest README documents burst-tested tiers.
LANGWATCH_WORKERS_REPLICAS=
LANGWATCH_MEMORY_LIMIT=
LANGWATCH_REDIS_MEMORY_LIMIT=
LANGWATCH_CLICKHOUSE_MEMORY_LIMIT=
LANGWATCH_CLICKHOUSE_CPU_LIMIT=

# [OPTIONAL] The remaining limits keep defaults (each workers replica is
# capped at LANGWATCH_WORKERS_MEMORY_LIMIT).
# LANGWATCH_WORKERS_MEMORY_LIMIT=1536m
# LANGWATCH_POSTGRES_MEMORY_LIMIT=256m

# [OPTIONAL] Logging knobs (decision 134 — one shared reader in core, both
# images write structured lines to stdout). Unset = level info, json lines.
# LOG_LEVEL=info        # trace|debug|info|warn|error|fatal|silent
# LOG_FORMAT=json       # json|pretty

# NOTE: deliberately NO LANGWATCH_API_KEY here (decision 127) — it is the
# AGENTS' credential for SENDING traces in; no container of this component
# reads it. It lives in LangWatch's own Postgres; agents receive it via the
# platform vault (copy from the LangWatch UI when seeding).
