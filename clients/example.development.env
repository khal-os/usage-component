# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ DEVELOPMENT ENV — the workstation/demo shape of one client deployment.    ║
# ║ Lean on purpose: only what a local stack needs. The FULL contract is      ║
# ║ example.production.env.                                                    ║
# ║                                                                            ║
# ║ scripts/1-init-client-env.sh GENERATES a file like this one (ports        ║
# ║ auto-allocated, secrets minted); copy by hand only to fill it yourself:   ║
# ║                                                                            ║
# ║   cp clients/example.development.env clients/<name>.env                   ║
# ║   docker compose -f compose.module.yml -f compose.connector.yml \         ║
# ║     -f compose.mongodb.yml -f compose.dev.yml \                           ║
# ║     --env-file clients/<name>.env up -d                                   ║
# ║                                                                            ║
# ║ Tags:  [REQUIRED] the stack won't start without it                        ║
# ║        [OPTIONAL] safe to ignore locally                                  ║
# ║        [DEV ONLY] never in a production env file                          ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─── IDENTITY ────────────────────────────────────────────────────────────────

# [REQUIRED] Compose project prefix and the client's database name — keep
# both equal to the client slug.
COMPOSE_PROJECT_NAME=example
CLIENT_NAME=example

# [REQUIRED] Decision 130: the client's business timezone (IANA) — billing
# boundary = display zone.
CLIENT_TIMEZONE=America/Sao_Paulo

# ─── PORTS & URLS ────────────────────────────────────────────────────────────

# [REQUIRED on a shared workstation] Unique per client (the generator
# auto-allocates from these bases).
API_PORT=3001
LANGWATCH_PORT=5561

# [REQUIRED] The browser-visible LangWatch URL — locally, just the published
# port. Compose refuses to start with it empty.
LANGWATCH_PUBLIC_URL=http://localhost:5561

# [DEV ONLY] Publish mongo on this localhost port for Compass/mongosh
# (compose.dev.yml). Leave unset in production env files.
MONGO_HOST_PORT=27018

# ─── SECRETS ─────────────────────────────────────────────────────────────────
# (Local only. In production these move to AWS Secrets Manager — see the
# [SECRET→SM] tags in example.production.env.)

# [OPTIONAL locally] Empty = auth-less dev mongo (set BEFORE first boot to
# enable auth — the volume keeps the first-boot user).
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# [REQUIRED even locally] Decision 139: the usage store's database name —
# declared, never inferred (the old CLIENT_NAME fallback is gone). The
# generator fills it with the client slug.
MONGO_USAGE_DB_NAME=example

# [REQUIRED even locally] Generate each: `openssl rand -base64 32`.
# CREDENTIALS_SECRET must never change after first boot.
LANGWATCH_NEXTAUTH_SECRET=
LANGWATCH_API_TOKEN_JWT_SECRET=
LANGWATCH_CREDENTIALS_SECRET=

# [REQUIRED even locally] Decision 139: LangWatch capacity is declared,
# never defaulted — compose refuses to start without these five (the
# 1000 traces/s incident ran dev-shaped fallbacks nobody chose). These
# ARE the dev-sized values; production sizes per client (see
# example.production.env §9 and the loadtest README).
LANGWATCH_WORKERS_REPLICAS=1
LANGWATCH_MEMORY_LIMIT=2g
LANGWATCH_REDIS_MEMORY_LIMIT=512m
LANGWATCH_CLICKHOUSE_MEMORY_LIMIT=2g
LANGWATCH_CLICKHOUSE_CPU_LIMIT=1.0

# ─── IMAGES ──────────────────────────────────────────────────────────────────

# [OPTIONAL] Locally-built images (`make images`); compose.dev.yml
# (re)builds them.
MODULE_IMAGE=platform-module:local
CONNECTOR_IMAGE=platform-connector:local

# ─── SYNC (demo knobs — fast feedback) ───────────────────────────────────────

# [OPTIONAL] Production keeps the defaults (60/1000/900/3600 — see
# example.production.env, decision 61).
TRACE_INGESTION_INTERVAL_SECONDS=5
TRACE_INGESTION_BATCH_SIZE=100
TRACE_INGESTION_QUIET_PERIOD_SECONDS=5
REPROCESS_INTERVAL_SECONDS=60

# [REQUIRED — written by scripts/3-onboard-langwatch.sh] While empty,
# ingestion idles and `make sync` refuses to run (decision 127).
LANGWATCH_PROJECT_ID=

# [DEV ONLY] Offline demo (decision 127): `make sync` reads generated
# fixtures instead of a real source. A real client NEVER sets this.
# TRACE_SOURCE=fixtures

# ─── KHAL SESSION AUTH ───────────────────────────────────────────────────────

# [OPTIONAL locally] Usually OFF in dev (API open, PoC behavior). To exercise
# the gate against a local khal-auth, see the block in
# example.production.env (KHAL_AUTH_URL=http://host.docker.internal:7101 +
# KHAL_TENANT — the URL resolves from inside the container, so never
# 127.0.0.1).

# [OPTIONAL] Logging knobs (decision 134 — one shared reader in core, both
# images write structured lines to stdout). Unset = level info, json lines.
# LOG_LEVEL=info        # trace|debug|info|warn|error|fatal|silent
# LOG_FORMAT=json       # json|pretty
